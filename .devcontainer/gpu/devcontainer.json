{
  "name": "Face recognition accuracy (NVIDIA GPU)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "runArgs": ["--gpus", "all"],
  "remoteUser": "vscode",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -e '.[gpu,test]'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
